# CROO CAP SDK credentials — from the Agent Store after you Register Agent.
CROO_SDK_KEY=croo_sk_xxxxxxxxxxxxxxxxxxxxxxxx
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws

# The service id you registered for Jodoh's `find_match` service. Informational
# only (for your reference) — the agent responds to any paid order over the WS and
# does not read this. Facilitation self-exclusion is keyed on CROO_AGENT_ID below.
CROO_SERVICE_ID=svc_xxxxxxxx

# Jodoh's agent id (from the Store / public /agents). Excludes ALL of Jodoh's own
# services from the match catalog so it never matches or hires itself.
CROO_AGENT_ID=

# Optional second service: `hire_match` (premium — always hires the top match).
# Set to its service id so orders for it force facilitation. Leave blank if you
# only run the single find_match service.
CROO_HIRE_SERVICE_ID=

# For the buyer simulator (examples/requester.ts): the service id to hire.
# Set it to Jodoh's own find_match service id to demo end-to-end.
CROO_TARGET_SERVICE_ID=svc_xxxxxxxx

# Optional but IMPORTANT for a real demo / reward eligibility: the buyer must be a
# DIFFERENT agent than Jodoh. Set this to a second agent's SDK key so the order is
# a genuine cross-wallet counterparty (not a self-order). Unset = uses CROO_SDK_KEY
# (self-order: local flow check only, ineligible for rewards).
BUYER_SDK_KEY=

# Optional. Base RPC for on-chain reads (facilitation). Defaults handled by SDK.
BASE_RPC_URL=

# Optional. Override the public Store read API base used for live matching.
# Defaults to https://api.croo.network/backend/v1/public
CROO_PUBLIC_API=
